<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@color/surface">

    <TextView android:id="@+id/optionsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textStyle="bold" android:textSize="19sp" android:maxLines="2" />
    <TextView android:id="@+id/optionsArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:textColor="@color/muted" android:textSize="13sp" />

    <LinearLayout android:id="@+id/actionAudio" style="@style/DronnkOptionRow"><ImageView style="@style/DronnkOptionIcon" android:src="@drawable/ic_download"/><TextView style="@style/DronnkOptionText" android:text="Descargar y reproducir audio"/></LinearLayout>
    <LinearLayout android:id="@+id/actionVideo" style="@style/DronnkOptionRow"><ImageView style="@style/DronnkOptionIcon" android:src="@drawable/ic_video"/><TextView style="@style/DronnkOptionText" android:text="Descargar video"/></LinearLayout>
    <LinearLayout android:id="@+id/actionFavorite" style="@style/DronnkOptionRow"><ImageView android:id="@+id/actionFavoriteIcon" style="@style/DronnkOptionIcon" android:src="@drawable/ic_heart_outline"/><TextView android:id="@+id/actionFavoriteText" style="@style/DronnkOptionText" android:text="Añadir a favoritos"/></LinearLayout>
    <LinearLayout android:id="@+id/actionPlaylist" style="@style/DronnkOptionRow"><ImageView style="@style/DronnkOptionIcon" android:src="@drawable/ic_playlist"/><TextView style="@style/DronnkOptionText" android:text="Añadir a playlist"/></LinearLayout>
    <LinearLayout android:id="@+id/actionShare" style="@style/DronnkOptionRow"><ImageView style="@style/DronnkOptionIcon" android:src="@drawable/ic_share"/><TextView style="@style/DronnkOptionText" android:text="Compartir"/></LinearLayout>
</LinearLayout>
