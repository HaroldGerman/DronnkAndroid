<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/primary_2" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/favorite"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_heart_outline"
            android:background="@android:color/transparent"
            android:tint="@color/muted"
            android:contentDescription="Favorito" />

        <ImageButton
            android:id="@+id/options"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_more"
            android:background="@android:color/transparent"
            android:tint="@color/text"
            android:contentDescription="Más opciones" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
