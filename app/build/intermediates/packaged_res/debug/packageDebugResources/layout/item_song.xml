<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="8dp">
    <ImageView android:id="@+id/cover" android:layout_width="58dp" android:layout_height="58dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:maxLines="1" />
    </LinearLayout>
    <ImageButton android:id="@+id/options" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@android:drawable/ic_menu_more" android:background="@android:color/transparent" android:tint="@color/text" />
</LinearLayout>
